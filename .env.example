# Backend only. Never commit .env. Use Supabase session pooler on IPv4 hosts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://PROJECT.supabase.co
# Public publishable key (or legacy anon key), never service_role/secret key.
SUPABASE_PUBLISHABLE_KEY=
XAI_API_KEY=
# Choose an ID returned by your authenticated GET https://api.x.ai/v1/models
XAI_MODEL=
AI_CALL_LIMIT=10
# demo: scripted approved-fact questions (no paid question requests).
# ai: Grok classifies supported questions; the backend answers from approved facts.
QUESTION_MODE=demo

# Enable paid listing drafts independently of scripted customer Q&A. Default follows QUESTION_MODE.
DRAFT_AI_ENABLED=0
